    {"id": "voltage_distribution", "title": "Voltage histogram share", "unit": "%", "operation": "histogram_distribution", "spatial": "ratio", "source": "C{core}_VOLT_HIST_R{pair}_R{pair_next}.C{core}_VOLT_HIST_R{bucket}", "buckets": 12, "labels": ["<602 mV", "602.5-657 mV", "657.5-712 mV", "712.5-767 mV", "767.5-822 mV", "822.5-877 mV", "877.5-932 mV", "932.5-987 mV", "987.5-1042 mV", "1042.5-1097 mV", "1097.5-1152 mV", ">1152 mV"], "invalid_values": [14943714.236], "provisional": "histogram_scale_unverified;voltage_r0_is_not_C6", "formula": "100 * delta[b] / sum(delta[0..11]); voltage distribution, not active-state voltage"},
    {"id": "temperature_distribution", "title": "Temperature histogram share", "unit": "%", "operation": "histogram_distribution", "spatial": "ratio", "source": "C{core}_TEMP_HIST_R{pair}_R{pair_next}.C{core}_TEMP_HIST_R{bucket}", "buckets": 12, "labels": ["<20 C", "20.5-27.5 C", "28-35 C", "35.5-42.5 C", "43-50 C", "50.5-57.5 C", "58-65 C", "65.5-72.5 C", "73-80 C", "80.5-87.5 C", "88-95 C", ">95 C"], "invalid_values": [14943714.236], "provisional": "histogram_scale_unverified", "formula": "100 * delta[b] / sum(delta[0..11]); one column per temperature bucket"}
