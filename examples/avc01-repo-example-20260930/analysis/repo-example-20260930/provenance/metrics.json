    {"id": "core_usage_lifetime", "title": "Core usage lifetime counter (experimental)", "unit": "core_usage", "operation": "gauge", "spatial": "sum", "source": "C{core}_USAGE_METER.C{core}_USAGE_METER", "invalid_values": [3735928559, 16045690984833335023], "formula": "current XML U64.38.26 core_usage; relative cumulative counter, not CPU utilization percent"},
    {"id": "core_usage_delta", "title": "Core usage interval increase (experimental)", "unit": "core_usage", "operation": "delta", "spatial": "sum", "source": "C{core}_USAGE_METER.C{core}_USAGE_METER", "invalid_values": [3735928559, 16045690984833335023], "formula": "current - previous over actual adjacent capture interval, not dashboard rolling 5-minute increase or utilization percent"},
    {"id": "pvp64_delta", "title": "PVP 64-cycle count increase", "unit": "count", "operation": "delta", "spatial": "sum", "source": "C{core}_PVP_THROTTLE_64.C{core}_PVP_THROTTLE_64", "invalid_values": [3735928559, 16045690984833335023], "formula": "current - previous; no reset/wrap inference"},
    {"id": "pvp64_rate", "title": "PVP 64-cycle rate", "unit": "count/s", "operation": "rate", "spatial": "sum", "source": "C{core}_PVP_THROTTLE_64.C{core}_PVP_THROTTLE_64", "invalid_values": [3735928559, 16045690984833335023], "formula": "(current - previous) / actual elapsed seconds"},
